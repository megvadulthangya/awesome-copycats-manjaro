-- {{{ Required libraries
pcall(require, "luarocks.loader")

-- ===================================================================
-- LUA MODULE PATH (system-wide Lua modules, pl. lua-json fork)
-- ===================================================================
-- Az Awesome beépített Lua-ja nem keresi a rendszer-szintű
-- /usr/share/lua/<ver>/ könyvtárat. A forkolt lua-json ide települ
-- (lásd PKGBUILD: install ... /usr/share/lua/5.5/json.lua).
--
-- A <ver>-t futásidőben a _VERSION-ből olvassuk ki (pl. "Lua 5.5"
-- -> "5.5"), így Lua 5.5 -> 5.6 -> 6.0 frissítés esetén is a helyes
-- útvonalat kapjuk. Feltétel: a lua-json csomag az új verzió alá is
-- telepítsen.
--
-- E nélkül a require("json") (és így a require("retain")) elhasal,
-- és a modules/tag-retain.lua kritikus értesítést dob.
do
    local ver = _VERSION and _VERSION:match("^Lua (%d+%.%d+)")
    if ver then
        local base = "/usr/share/lua/" .. ver
        if not package.path:find(base .. "/?.lua", 1, true) then
            package.path = package.path .. ";" .. base .. "/?.lua"
        end
        if not package.path:find(base .. "/?/init.lua", 1, true) then
            package.path = package.path .. ";" .. base .. "/?/init.lua"
        end
    end
end
-- ===================================================================

